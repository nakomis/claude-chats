        <mxCell id="note1" value="&lt;i&gt;Every hop is outbound. The home network accepts no inbound connections:&lt;br/&gt;the Mac pushes to SQS, Cal polls from it, and Postgres stays on the LAN.&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#777777;" vertex="1" parent="1">
          <mxGeometry x="540" y="645" width="560" height="40" as="geometry" />
