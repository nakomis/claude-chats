# ESP-IDF build output and generated config
firmware/*/build/
firmware/*/managed_components/
firmware/*/sdkconfig
firmware/*/sdkconfig.old
firmware/*/dependencies.lock
# generated from a specific mxbai.bin by host/gen_crc.py
firmware/full/main/mxcrc.h
# model images, test vectors and the local transcript sample
host/*.bin
host/corpus.json
host/corpus_ids.json
# built by host/tok.py
tok/libtok.so
host/tail.npz
host/recal.npz
# Wi-Fi credentials, generated by host/gen_wifi_secrets.sh
firmware/*/main/wifi_secrets.h
# generated by host/gen_long.py
firmware/full/main/longtest.h
firmware/*/.cache/
# host test binaries (test/Makefile)
test/test_batch
test/test_att
