# ESP-IDF build output and generated config
firmware/*/build/
firmware/*/managed_components/
firmware/*/sdkconfig
firmware/*/sdkconfig.old
firmware/*/dependencies.lock
!firmware/full/dependencies.lock
# model images, test vectors and the local transcript sample
host/*.bin
host/corpus.json
host/corpus_ids.json
# built by host/tok.py
tok/libtok.so
tok/test_tok
# built by the otacmd host test
otacmd/otacmd
host/tail.npz
host/recal.npz
# Per-board provisioning (infra/scripts/provision.sh): prov.bin holds the Wi-Fi password
firmware/full/certs/
# Old builds read Wi-Fi from a generated header; nothing does now, but one may linger
firmware/*/main/wifi_secrets.h
firmware/*/.cache/
# CDK
infra/node_modules/
infra/cdk.out/
