CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CHATS-17: the task watchdog is on, but watches only kata_worker.c's guard task, not the idle tasks
# (a pass keeps both cores busy for minutes). The guard feeds it while the worker's own watchdog (an
# esp_timer callback) keeps ticking, so a wedged esp_timer task, which the software watchdog can't
# see, still ends in a panic, and so a reboot.
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_FATFS_USE_FASTSEEK=y
# CHATS-4: Wi-Fi and TLS next to the model. Wi-Fi/lwIP buffers stay internal (putting them in PSRAM
# didn't change the core-0 corruption, and internal ends up with more free this way); mbedTLS in PSRAM.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# CHATS-5: software AES. With mbedTLS's buffers in PSRAM, hardware AES bounces every record through
# two 1600-byte internal DMA buffers, and internal RAM, low and fragmented next to the model, didn't
# always have them: "esp-aes: Failed to allocate memory", a SendMessageBatch lost mid-write. The
# software tables are in flash (MBEDTLS_AES_ROM_TABLES), and TLS here is a few KB a minute.
CONFIG_MBEDTLS_HARDWARE_AES=n
# Wi-Fi/lwIP hot paths live in flash, not IRAM (on the S3, IRAM comes out of the same SRAM)
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
# fewer buffers: this is a client fetching small messages, not a throughput device
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_TX_BA_WIN=4
CONFIG_ESP_WIFI_RX_BA_WIN=4
# network tasks on core 1 (made no difference to the corruption, which stays on core 0)
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_1=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU1=y
# CHATS-17: a panic reboots. It used to halt (bring-up: a halted chip still answers esptool over USB, a
# boot loop may not), and on 20 Oct 2026 one SD timeout's abort() left kata-prod-green halted for 28 h
# until her power was cut. The core dump still goes to flash first, and the next heartbeat names it.
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
# ...after 30 s, so a crash that recurs at once (a dead card) can't churn the core dump's flash every
# few seconds; after three in a row full.c boots without the model and reports instead
CONFIG_ESP_SYSTEM_PANIC_REBOOT_DELAY_SECONDS=30
# CHATS-10: tinycrypt's OTA groundwork, ahead of Fleet. Two app slots (partitions.csv), and a new
# image that fails before it's marked valid is rolled back by the bootloader. Images are signed
# (RSA-3072, the secure boot v2 scheme) outside the build (sign.sh locally, tools/ci-publish.sh in
# CI); an update will be checked against the key that signed the running app, so USB-flashed
# builds are signed too. Without secure boot this protects updates, not a USB cable.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=n
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
# CHATS-5: age, to decrypt conversation-memory jobs (worker/age.c): ChaCha20-Poly1305 and HKDF.
# X25519 (Curve25519), SHA-256 and MD5 (SQS's body checks) are on already. Under 1 KB of RAM.
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_POLY1305_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
CONFIG_MBEDTLS_HKDF_C=y
# CHATS-5: the heartbeat builds Kata's status (fleet.c) in the esp_timer task
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4608
# CHATS-16: statusd resets refused and timed-out connections (SO_LINGER 0) rather than leave a
# TIME_WAIT pcb in internal RAM for two minutes
CONFIG_LWIP_SO_LINGER=y
